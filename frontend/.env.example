# 默认连接真实后端，Vite 将 /api 代理到以下地址。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_UPLOAD_URL=/api/documents/upload
VITE_KNOWLEDGE_BASES_URL=/api/knowledge-bases
VITE_DOCUMENT_TASKS_URL=/api/document-tasks
# 仅在需要离线演示时设为 demo；默认 api。
VITE_UPLOAD_MODE=api

# 文档删除接口前缀；默认通过 Vite 代理访问后端。
VITE_DOCUMENTS_URL=/api/documents
