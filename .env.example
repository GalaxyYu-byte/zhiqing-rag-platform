# 复制为 .env 后填写实际连接信息；此文件不包含任何真实凭据。
APP_NAME="zhiqing-rag-platform"
APP_ENV="dev"
APP_HOST="127.0.0.1"
APP_PORT="8000"
LOG_LEVEL="INFO"
# 上传解析配置由服务端统一管理，页面用户不可修改。
UPLOAD_CHUNK_SIZE="512"
UPLOAD_CHUNK_OVERLAP="48"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME='zhiqing_rag_platform'
DB_USERNAME="ragkb"
DB_PASSWORD=""
DB_SCHEMA="zhiqing_rag"
# 每个进程、每组数据库配置的池容量；按需建连，最多 SIZE + OVERFLOW 条连接。
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="10"
# 池满时等待可用连接的秒数，超时返回数据库不可用，不跳过权限校验。
DB_POOL_TIMEOUT="30"
DB_ECHO="false"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
REDIS_MAX_CONNECTIONS="16"
REDIS_KEY_PREFIX="zhiqing-rag:"
ARQ_QUEUE_NAME="zhiqing-rag:arq:default"
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="rag-documents"
MINIO_OBJECT_PREFIX="zhiqing-rag-platform/"
NEO4J_ENABLED="false"
NEO4J_URI="bolt://127.0.0.1:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"
GRAPH_NAMESPACE="zhiqing-rag-platform"
DASHSCOPE_API_KEY=""
OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
CHAT_MODEL="qwen-plus"
CHAT_TEMPERATURE="0.1"
EMBEDDING_MODEL="text-embedding-v3"
EMBEDDING_DIMENSIONS="1024"
EMBEDDING_CACHE_ENABLED="true"
EMBEDDING_CACHE_TTL_SECONDS="604800"
EMBEDDING_CACHE_REVISION="local-config-v1"
EMBEDDING_CACHE_TIMEOUT_SECONDS="1"
RERANKER_ENDPOINT="https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank"
RERANKER_MODEL="gte-rerank-v2"
QUERY_EMBEDDING_TIMEOUT_SECONDS="10"
QUERY_RERANKER_TIMEOUT_SECONDS="10"
QUERY_RERANKER_ENABLED="true"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
QUERY_ANALYZER_MODEL="deepseek-flash"
QUERY_ANALYZER_ENABLED="true"
QUERY_ANALYZER_TIMEOUT_SECONDS="15"
QUERY_ANALYZER_MAX_OUTPUT_TOKENS="2048"
GRAPH_EXTRACTION_MODEL="deepseek-flash"
GRAPH_POLL_SECONDS="2"
GRAPH_LEASE_SECONDS="120"
GRAPH_MAX_ATTEMPTS="3"
GRAPH_LLM_TIMEOUT_SECONDS="60"
GRAPH_LLM_MAX_OUTPUT_TOKENS="24576"
# 登录必需：生成并填写至少 32 字节的随机密钥，禁止提交真实值。
JWT_SECRET_KEY=""
JWT_ISSUER="zhiqing-rag-platform"
JWT_AUDIENCE="zhiqing-rag-web"
REFRESH_COOKIE_NAME="zhiqing_refresh_token"
REFRESH_COOKIE_SECURE="false"
SERVICE_TIMEOUT_SECONDS="5"

# 文档上传；HTTP 接口要求正式登录，不再提供开发身份绕过。
CORS_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'
UPLOAD_MAX_FILE_SIZE="52428800"
# 下面的身份仅供旧联调脚本定位测试数据，不影响 HTTP 鉴权。
DEV_UPLOAD_IDENTITY_ENABLED="false"
DEV_UPLOAD_USER_EMAIL="admin@zhiqing.test"
DEV_UPLOAD_TENANT_CODE="DEFAULT"
# 独立 PostgreSQL 索引 Worker：并发、租约和总处理预算。
INGESTION_POLL_SECONDS="2"
INGESTION_CONCURRENCY="2"
INGESTION_LEASE_SECONDS="90"
INGESTION_TIMEOUT_SECONDS="1200"
INGESTION_MAX_ATTEMPTS="3"
